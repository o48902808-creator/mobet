{
  "name": "Android Settings demo",
  "package": "com.android.settings",
  "variables": {
    "network_page": "Network & internet"
  },
  "policy": {
    "allowedPackages": ["com.android.settings"],
    "allowedActions": ["wait", "tap", "confirm", "back"],
    "maxActions": 10,
    "maxRuntimeMs": 30000,
    "allowVisualFallbacks": false
  },
  "steps": [
    { "action": "wait", "text": "Settings", "timeoutMs": 5000, "retries": 1 },
    { "action": "tap", "text": "{{var:network_page}}", "timeoutMs": 5000, "retries": 1 },
    { "action": "wait", "text": "{{var:network_page}}", "timeoutMs": 5000 },
    { "action": "confirm", "message": "Allow Mobet to return to the previous screen?" },
    { "action": "back" }
  ]
}
