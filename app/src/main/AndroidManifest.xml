<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AlarmManager drops scheduled alarms at power-off. Without this, a stored run reminder
         would silently never fire after the phone restarts. The boot receiver below only
         re-arms alarms and posts reminder notifications; it cannot start a workflow. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      ML Kit's bundled text-recognition model pulls in com.google.android.datatransport
      (transport-backend-cct), whose manifest declares INTERNET and ACCESS_NETWORK_STATE for
      telemetry upload. The manifest merger folds those into our APK, which silently broke the
      central promise that Mobet cannot reach the network — OCR itself is entirely on-device and
      needs neither permission.

      These removals are enforced by :app:verifyDebugNoNetworkPermission, which reads the MERGED
      manifest and fails the build if a network permission survives. Do not delete them without
      reading docs/THREAT_MODEL.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!-- Least-privilege package visibility: only apps exposing launcher activities are visible. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobet">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-target intake: open a .mobet.json bundle (or any JSON doc) from a file
                 manager or another app. Content is untrusted and re-enters through the same
                 streamed, capped, validator-gated import path as the in-app picker; nothing
                 runs without explicit review (docs/THREAT_MODEL.md). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Posts a reminder notification at a chosen time. It never starts a workflow:
             the user still opens Mobet and presses Run, preserving the invariant that every
             device action is explicitly user-initiated. -->
        <receiver
            android:name=".automation.RunReminder$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ai.arena.mobet.REMINDER_FIRE" />
            </intent-filter>
        </receiver>

        <!-- Restores pending reminders after a reboot: re-arms alarms still in the future and
             posts any reminder whose time passed while the device was off. BOOT_COMPLETED is a
             protected broadcast only the system can send; exported=false also blocks spoofed
             explicit intents. Never starts a workflow (docs/THREAT_MODEL.md). -->
        <receiver
            android:name=".automation.RunReminder$BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Scoped strictly to files/exports/ so sharing a workflow cannot leak captures,
             secrets, or ledger data. Not exported; access is granted per-URI at share time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- QS tile: triggers the pinned workflow from the shade (docs/FRONTIER.md pillar 4).
             A click only opens the app on the pinned run — confirmation gates still apply.
             BIND_QUICK_SETTINGS_TILE is a signature permission the system itself enforces. -->
        <service
            android:name=".automation.MobetTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_run"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".automation.MobetAccessibilityService"
            android:exported="false"
            android:label="Mobet automation"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
