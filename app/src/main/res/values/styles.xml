<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Cards ===== -->
    <style name="Widget.Mobet.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/mobet_surface</item>
        <item name="cardCornerRadius">@dimen/mobet_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mobet_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/mobet_card_padding</item>
    </style>

    <style name="Widget.Mobet.Card.Hero">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.Mobet.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/mobet_touch_target</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">@dimen/mobet_button_radius</item>
    </style>

    <style name="Widget.Mobet.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/mobet_touch_target</item>
        <item name="cornerRadius">@dimen/mobet_button_radius</item>
    </style>

    <style name="Widget.Mobet.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/mobet_touch_target</item>
        <item name="cornerRadius">@dimen/mobet_button_radius</item>
    </style>

    <style name="Widget.Mobet.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/mobet_touch_target</item>
    </style>

    <style name="Widget.Mobet.Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/mobet_touch_target</item>
        <item name="cornerRadius">@dimen/mobet_button_radius</item>
        <item name="backgroundTint">@color/mobet_danger_container</item>
        <item name="android:textColor">@color/mobet_danger</item>
        <item name="iconTint">@color/mobet_danger</item>
    </style>

    <!-- A compact, icon-above-label tool tile used inside the tool grids. -->
    <style name="Widget.Mobet.ToolTile" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/mobet_tile_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="cornerRadius">@dimen/mobet_card_radius</item>
    </style>

    <!-- ===== Text ===== -->
    <style name="TextAppearance.Mobet.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.Mobet.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Mobet.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Mobet.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/mobet_code_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- ===== Inputs ===== -->
    <style name="Widget.Mobet.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/mobet_input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/mobet_input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/mobet_input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/mobet_input_radius</item>
    </style>

    <style name="Widget.Mobet.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="chipMinHeight">28dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>
