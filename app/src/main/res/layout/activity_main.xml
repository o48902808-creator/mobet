<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollColor="?attr/colorSurfaceVariant">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleCentered="false"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            app:subtitle="@string/app_tagline"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
            app:menu="@menu/main"
            app:layout_scrollFlags="scroll|enterAlways|snap" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/mobet_screen_padding"
            android:paddingEnd="@dimen/mobet_screen_padding"
            android:paddingTop="@dimen/mobet_gap_small">

            <!-- ══ Service state ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serviceCard"
                style="@style/Widget.Mobet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedIconTint="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/serviceDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_status_dot" />

                        <TextView
                            android:id="@+id/serviceState"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Mobet.CardTitle"
                            tools:text="Automation service enabled" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/serviceDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Mobet.Body"
                        tools:text="Enable Mobet in Android Accessibility settings." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openAccessibility"
                        style="@style/Widget.Mobet.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap"
                        android:text="@string/open_accessibility_settings"
                        app:icon="@drawable/ic_accessibility" />

                    <!-- Android 13+ hides the Accessibility toggle for sideloaded installs.
                         This shortcut explains the unlock path instead of leaving the user
                         staring at a greyed-out switch. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restrictedHelp"
                        style="@style/Widget.Mobet.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/restricted_help_link"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_info"
                        app:iconSize="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Workflow editor ════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mobet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mobet_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_steps"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_workflow"
                                android:textAppearance="@style/TextAppearance.Mobet.SectionLabel" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/formatJson"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/action_format"
                            app:icon="@drawable/ic_format"
                            app:iconSize="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/expandEditor"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/action_fullscreen"
                            app:icon="@drawable/ic_expand"
                            app:iconSize="20dp" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/workflowSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="0dp"
                        app:singleLine="false" />

                    <ai.arena.mobet.ui.LineNumberEditText
                        android:id="@+id/editor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap_small"
                        android:background="@drawable/bg_code_editor"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:hint="@string/workflow_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minHeight="@dimen/mobet_editor_min_height"
                        android:padding="14dp"
                        android:scrollHorizontally="true"
                        android:textColor="@color/mobet_code_text"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        tools:ignore="LabelFor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap_small"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/saveWorkflow"
                            style="@style/Widget.Mobet.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_save"
                            app:icon="@drawable/ic_save"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loadWorkflow"
                            style="@style/Widget.Mobet.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mobet_gap_small"
                            android:layout_weight="1"
                            android:text="@string/action_load"
                            app:icon="@drawable/ic_library"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/manageSecrets"
                            style="@style/Widget.Mobet.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/mobet_gap_small"
                            android:layout_weight="1"
                            android:text="@string/action_secrets"
                            app:icon="@drawable/ic_secret"
                            app:iconSize="18dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recordTaps"
                        style="@style/Widget.Mobet.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/action_record_taps"
                        app:icon="@drawable/ic_record"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editSteps"
                        style="@style/Widget.Mobet.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap_small"
                        android:text="@string/action_edit_steps"
                        app:icon="@drawable/ic_steps"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chooseTarget"
                        style="@style/Widget.Mobet.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_choose_target"
                        app:icon="@drawable/ic_apps"
                        app:iconSize="18dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Plan &amp; autonomy ════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mobet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mobet_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_plan"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_planning"
                            android:textAppearance="@style/TextAppearance.Mobet.SectionLabel" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/planning_caption"
                        android:textAppearance="@style/TextAppearance.Mobet.Body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generatePlan"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_generate_plan"
                            app:icon="@drawable/ic_plan" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/runGoal"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_run_goal"
                            app:icon="@drawable/ic_agent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dryRun"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_dry_run"
                            app:icon="@drawable/ic_dryrun" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Inspect &amp; verify ═══════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mobet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mobet_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_inspect"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_tools"
                            android:textAppearance="@style/TextAppearance.Mobet.SectionLabel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap_small"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/inspectScreen"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_inspect"
                            app:icon="@drawable/ic_inspect" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/showDiagnostics"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_diagnostics"
                            app:icon="@drawable/ic_diagnostics" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/showCaptures"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_captures"
                            app:icon="@drawable/ic_captures" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/showAudit"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_audit"
                            app:icon="@drawable/ic_ledger" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/showMemory"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_agent_memory"
                            app:icon="@drawable/ic_memory" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/validatePolicy"
                            style="@style/Widget.Mobet.ToolTile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_validate"
                            app:icon="@drawable/ic_policy" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Activity / status ═════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mobet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mobet_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ledger"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/section_activity"
                            android:textAppearance="@style/TextAppearance.Mobet.SectionLabel" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/runProgress"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="18dp"
                            app:trackThickness="2dp"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mobet_gap_small"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_status_surface"
                        android:fontFamily="monospace"
                        android:maxHeight="150dp"
                        android:padding="12dp"
                        android:scrollbars="vertical"
                        android:textColor="@color/mobet_code_text"
                        android:textSize="12sp"
                        tools:text="Ready. Enable the service, then run the included Settings demo." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Safety notice ═════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mobet_gap"
                android:background="@drawable/bg_notice_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/mobet_warning" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/safety_notice"
                    android:textColor="@color/mobet_warning"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ Pinned run bar ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/runBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mobet_screen_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/mobet_screen_padding"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runWorkflow"
            style="@style/Widget.Mobet.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:elevation="2dp"
            android:text="@string/action_run"
            android:textSize="15sp"
            app:icon="@drawable/ic_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopRun"
            style="@style/Widget.Mobet.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/mobet_gap_small"
            android:contentDescription="@string/action_stop_description"
            android:text="@string/action_stop"
            app:icon="@drawable/ic_stop" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
